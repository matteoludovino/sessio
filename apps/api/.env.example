NODE_ENV=development
PORT=3100
DATABASE_URL=postgres://sessio:sessio@localhost:5434/sessio
WEB_ORIGIN=http://localhost:5173

# Mail: smtp (Mailpit in development: UI on http://localhost:8025), resend, or log
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Sessio <no-reply@sessio.local>
# RESEND_API_KEY=

# Secrets: 32+ random characters in production (the app refuses to start otherwise)
JOBS_SECRET=dev-jobs-secret-change-me
LINK_SECRET=dev-link-secret-change-me

# Periodic jobs while the API is awake (0 = only POST /api/internal/jobs/run)
JOBS_INTERVAL_MINUTES=5
OUTBOX_RELAY=on
# Demo deployment: mails are kept for the in-app outbox instead of being sent
DEMO_MODE=false
