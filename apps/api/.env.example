NODE_ENV=development
PORT=3100
DATABASE_URL=postgres://sessio:sessio@localhost:5434/sessio
WEB_ORIGIN=http://localhost:5173

# Mail: smtp (Mailpit in development: UI on http://localhost:8025), resend, or log
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Sessio <no-reply@sessio.local>
# RESEND_API_KEY=

# Secrets: 32+ random characters in production (the app refuses to start otherwise)
JOBS_SECRET=dev-jobs-secret-change-me
LINK_SECRET=dev-link-secret-change-me

# Password hashes computed at once. scrypt takes 128 MiB per hash by design: on a 512 MiB
# instance keep 1, or a burst of sign-ins runs out of memory (the rest queue).
PASSWORD_HASH_CONCURRENCY=1

# Periodic jobs while the API is awake (0 = only POST /api/internal/jobs/run)
JOBS_INTERVAL_MINUTES=5
OUTBOX_RELAY=on
# Public demo: mails are also kept for the in-app outbox, an empty database seeds the demo clinic
# on boot, POST /api/internal/demo/reset (JOBS_SECRET) rebuilds it, and the shared demo accounts
# can't be deactivated. Pair it with MAIL_TRANSPORT=log so nothing leaves the server.
DEMO_MODE=false

# Clinical notes keyring: "version:base64(32 random bytes)", comma-separated; the highest version
# encrypts, older ones still decrypt (rotation). Generate a key with: openssl rand -base64 32
# Leave unset in development (a fixed dev key is used); production refuses the dev key.
# NOTES_ENCRYPTION_KEYS=1:...
